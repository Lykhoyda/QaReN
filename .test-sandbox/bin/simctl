#!/usr/bin/env bash
if [ "${1:-}" = list ]; then
  json=
  case " $* " in *" --json "*|*" -j "*) json=1 ;; esac
  case " $* " in
    *" runtimes "*)
      [ -n "$json" ] && { echo '{"runtimes":[{"name":"iOS 18.0","identifier":"com.apple.CoreSimulator.SimRuntime.iOS-18-0","platform":"iOS","version":"18.0","isAvailable":true}]}'; exit 0; } ;;
    *" devices "*)
      if [ -n "$json" ]; then
        echo '{"devices":{"com.apple.CoreSimulator.SimRuntime.iOS-18-0":[{"udid":"5A4DB0C5-0000-4000-8000-00000000F4CE","name":"Sandbox iPhone","state":"Booted","isAvailable":true,"deviceTypeIdentifier":"com.apple.CoreSimulator.SimDeviceType.iPhone-16"}]}}'
      else
        printf '== Devices ==\n-- iOS 18.0 --\n    Sandbox iPhone (%s) (Booted)\n' "5A4DB0C5-0000-4000-8000-00000000F4CE"
      fi
      exit 0 ;;
  esac
fi
echo "qaren-sim-sandbox: refused simctl $*" >&2
exit 1
