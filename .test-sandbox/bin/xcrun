#!/usr/bin/env bash
all=("$@")
case "${1:-}" in --sdk|-sdk) shift 2 ;; esac
case "${1:-}" in
  simctl|devicectl|xcodebuild) exec "/Users/antonlykhoyda/.no-mistakes/worktrees/3df3fd656078/01M5VP58J95FRDZEV113TKYF8D/.test-sandbox/bin/$1" "${@:2}" ;;
  --find|-f)
    case "${@: -1}" in simctl|devicectl|xcodebuild) echo "/Users/antonlykhoyda/.no-mistakes/worktrees/3df3fd656078/01M5VP58J95FRDZEV113TKYF8D/.test-sandbox/bin/${@: -1}"; exit 0 ;; esac
    [ -n "/usr/bin/xcrun" ] && exec "/usr/bin/xcrun" "${all[@]}" ;;
  --show-sdk-*|vtool|otool|nm) [ -n "/usr/bin/xcrun" ] && exec "/usr/bin/xcrun" "${all[@]}" ;;
esac
echo "qaren-sim-sandbox: refused xcrun ${all[*]}" >&2
exit 1
