{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . :/packages/qaren-design :/packages/qaren-cli/src/main.rs :/packages/qaren-plugin/.claude-plugin/plugin.json :/packages/qaren-plugin/CHANGELOG.md :/packages/qaren-core/CHANGELOG.md || exit 1",
  "outputDirectory": ".next",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/QaReN/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/QaReN/:path*/",
      "destination": "/:path*/",
      "permanent": true
    }
  ]
}
