{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/QaReN/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/QaReN/getting-started/",
      "destination": "/getting-started/",
      "permanent": true
    },
    {
      "source": "/QaReN/plugin/",
      "destination": "/plugin/",
      "permanent": true
    },
    {
      "source": "/QaReN/pull-requests/",
      "destination": "/pull-requests/",
      "permanent": true
    },
    {
      "source": "/QaReN/plans/",
      "destination": "/plans/",
      "permanent": true
    },
    {
      "source": "/QaReN/saved-blocks/",
      "destination": "/saved-blocks/",
      "permanent": true
    },
    {
      "source": "/QaReN/configuration/",
      "destination": "/configuration/",
      "permanent": true
    },
    {
      "source": "/QaReN/cli/",
      "destination": "/cli/",
      "permanent": true
    },
    {
      "source": "/QaReN/check/",
      "destination": "/check/",
      "permanent": true
    },
    {
      "source": "/QaReN/watch/",
      "destination": "/watch/",
      "permanent": true
    },
    {
      "source": "/QaReN/troubleshooting/",
      "destination": "/troubleshooting/",
      "permanent": true
    },
    {
      "source": "/QaReN/actions/rn-flow-1/",
      "destination": "/actions/rn-flow-1/",
      "permanent": true
    },
    {
      "source": "/QaReN/changelog/",
      "destination": "/changelog/",
      "permanent": true
    },
    {
      "source": "/QaReN",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/QaReN/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
