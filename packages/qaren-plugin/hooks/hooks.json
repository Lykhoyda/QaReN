{
  "description": "SessionStart verifies the qaren runtime and prints the install command; it never downloads.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-qaren.sh\" --print-bin",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
