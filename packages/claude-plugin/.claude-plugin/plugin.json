{
  "name": "rn-dev-agent",
  "version": "1.1.0",
  "description": "AI agent that fully tests React Native features on simulator/emulator — navigates the app, verifies UI, walks user flows, and confirms internal state.",
  "author": {
    "name": "Anton Lykhoyda",
    "url": "https://github.com/Lykhoyda"
  },
  "homepage": "https://github.com/Lykhoyda/rn-dev-agent",
  "repository": "https://github.com/Lykhoyda/rn-dev-agent",
  "license": "MIT",
  "keywords": [
    "react-native",
    "expo",
    "testing",
    "debugging",
    "simulator",
    "emulator",
    "cdp",
    "maestro"
  ],
  "skills": [
    "./skills/using-rn-dev-agent",
    "./skills/rn-workflow",
    "./skills/rn-feature-development",
    "./skills/rn-device-control",
    "./skills/rn-testing",
    "./skills/rn-debugging",
    "./skills/rn-best-practices",
    "./skills/rn-setup",
    "./skills/creating-actions",
    "./skills/capturing-proof",
    "./skills/sending-feedback"
  ],
  "agents": [
    "./agents/rn-tester.md",
    "./agents/rn-pr-qa.md",
    "./agents/rn-debugger.md",
    "./agents/rn-code-explorer.md",
    "./agents/rn-code-architect.md",
    "./agents/rn-code-reviewer.md"
  ],
  "commands": [
    "./commands/qa-pr.md",
    "./commands/test-feature.md",
    "./commands/debug-screen.md",
    "./commands/check-env.md",
    "./commands/build-and-test.md",
    "./commands/rn-feature-dev.md",
    "./commands/proof-capture.md",
    "./commands/nav-graph.md",
    "./commands/send-feedback.md",
    "./commands/setup.md",
    "./commands/doctor.md",
    "./commands/list-learned-actions.md",
    "./commands/run-action.md",
    "./commands/check-vercel-rules.md",
    "./commands/observe.md",
    "./commands/lock-e2e.md",
    "./commands/run-workflow.md"
  ],
  "mcpServers": {
    "cdp": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/rn-dev-agent-core/dist/supervisor.js"
      ],
      "env": {
        "RN_DEV_AGENT_CODEX_PLUGIN_ROOT": "",
        "CODEX_PLUGIN_ROOT": ""
      }
    }
  }
}
