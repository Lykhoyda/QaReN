{
  "name": "rn-dev-agent-core",
  "version": "1.1.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rn-dev-agent-core": "./dist/supervisor.js",
    "rn-experience-trends": "./dist/experience-trends.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && mkdir -p dist/native && cp -R native/. dist/native/",
    "prepack": "yarn build && yarn build:web",
    "build:web": "cd src/observability/web && npm install && npm run build",
    "dev": "tsc --watch",
    "schema:proof": "yarn build && node dist/scripts/export-proof-schema.js",
    "schema:proof:check": "yarn build && node dist/scripts/export-proof-schema.js --check",
    "test": "yarn build:test && node --test --test-concurrency=2 'test/unit/*.test.js' 'test/unit/**/*.test.js' 'test/unit/*.test.ts' 'test/unit/**/*.test.ts' && node --test --test-concurrency=1 'test/serial/*.test.ts'",
    "test:coverage": "yarn build:test && node --test --test-concurrency=2 --experimental-test-coverage --test-coverage-exclude='test/**' ${UNIT_TEST_SHARD:+--test-shard=$UNIT_TEST_SHARD} 'test/unit/*.test.js' 'test/unit/**/*.test.js' 'test/unit/*.test.ts' 'test/unit/**/*.test.ts'",
    "test:contract": "yarn build:test && node --test test/unit/gh-383-protocol-sync.test.js test/unit/gh-418-command-surface-sync.test.js test/unit/gh-437-golden-contract.test.ts",
    "test:installed-expo-ios": "yarn build:test && RN_DEV_AGENT_INSTALLED_EXPO_IOS_TEST=1 node --test test/integration/managed-metro-installed-expo-ios.test.ts",
    "test:managed-product-bundle": "yarn build:test && RN_DEV_AGENT_MANAGED_PRODUCT_BUNDLE_TEST=1 node --test test/integration/managed-metro-product-bundle.test.ts",
    "test:expo-dev-client-manifest": "yarn build:test && RN_DEV_AGENT_EXPO_DEV_CLIENT_MANIFEST_TEST=1 node --test test/integration/managed-metro-expo55-dev-client-manifest.test.ts",
    "test:integration": "yarn build:test && node --test 'test/integration/*.test.js' 'test/integration/**/*.test.js' 'test/integration/*.test.ts' 'test/integration/**/*.test.ts'",
    "test:all": "yarn build:test && node --test 'test/unit/*.test.js' 'test/unit/**/*.test.js' 'test/unit/*.test.ts' 'test/unit/**/*.test.ts' 'test/integration/*.test.js' 'test/integration/**/*.test.js' 'test/integration/*.test.ts' 'test/integration/**/*.test.ts' && node --test --test-concurrency=1 'test/serial/*.test.ts'",
    "test:e2e-web": "yarn build:test && playwright test --config test/e2e-web/playwright.config.ts",
    "build:test": "yarn build && yarn build:web"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@expo/cli": "56.1.13",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "ajv": "8.17.1",
    "typescript": "^5.4.0",
    "zod-to-json-schema": "3.25.2"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@hono/node-server": ">=1.19.13 <2",
    "fast-uri": ">=3.1.2 <4",
    "hono": ">=4.12.18 <5",
    "ip-address": ">=10.1.1 <11"
  }
}
